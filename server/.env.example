# Server Environment Variables Template
PORT=3001
NODE_ENV=development

# Supabase Connection
SUPABASE_URL=https://rduxyhkwgykejczxircd.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Optional but recommended for backend persistence bypass of user RLS:
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google Gemini AI Post-Call Review (Phase 4)
# Supported models: gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_API_KEY=your_actual_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
